#include <winver.h>
1 24 "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,1,1,0
PRODUCTVERSION 2,1,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904b0"
    BEGIN
      VALUE "FileDescription", "CS2 128-Tick Patcher (experimental, LAN only)"
      VALUE "FileVersion", "2.1.1"
      VALUE "ProductName", "CS2 128-Tick Patcher"
      VALUE "ProductVersion", "2.1.1"
      VALUE "OriginalFilename", "cs2_128tick.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x809, 1200
  END
END
