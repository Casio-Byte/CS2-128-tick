#include <winver.h>
1 24 "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 3,0,0,0
PRODUCTVERSION 3,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904b0"
    BEGIN
      VALUE "CompanyName", "Casio"
      VALUE "LegalCopyright", "Copyright (c) 2026 Casio (MIT License)"
      VALUE "FileDescription", "CS2 128 Tick Launcher (experimental, LAN only)"
      VALUE "FileVersion", "3.0.0"
      VALUE "ProductName", "CS2 128 Tick Launcher"
      VALUE "ProductVersion", "3.0.0"
      VALUE "OriginalFilename", "cs2_128tick_launcher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x809, 1200
  END
END
